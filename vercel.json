{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60 }
    },
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(healthz|readyz)", "dest": "/api/index.py" },
    { "src": "/demo/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/web/$1", "continue": true }
  ]
}
